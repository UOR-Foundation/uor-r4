# Build output.
/target/
**/target/

# The scaling harness writes its fits here; the committed artifact is the
# report in `oracles/`, not the raw run.
/reports/
criterion/

# cargo-fuzz working state. The corpus that matters is committed under
# `fuzz/corpus/`; the rest is machine-local.
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/target/

# Editor and OS noise.
.DS_Store
*.swp
*~
.idea/
.vscode/

# `Cargo.lock` is NOT ignored: the resolved version of every oracle is part of
# the claim made against it (R11).
