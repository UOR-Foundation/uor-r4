 /// address (eight words), the carried cursor, the token ahead of it, the
 /// slot (five words), the place the slot read and the token.
 pub const STEP_WORDS: usize = 23;
+#[derive(Debug)]
+pub struct CursorIntervention {
+    pub original_start: Option<usize>,
+    pub triggered: bool,
+    pub applied: bool,
+    pub discarded: bool,
+    pub step: Option<usize>,
+    pub from: Option<usize>,
+    pub to: Option<usize>,
+}
+impl CursorIntervention {
+    fn new(original_start: Option<usize>) -> Self {
+        Self { original_start, triggered: false, applied: false, discarded: false, step: None, from: None, to: None }
+    }
+    fn apply(&mut self, named: &mut Named, cursor: Option<usize>, prompt: &[u32], step: usize) {
+        let Some(source) = named.source else { return; };
+        if self.triggered || cursor != Some(source) || source >= prompt.len() { return; }
+        self.triggered = true;
+        self.step = Some(step);
+        self.from = Some(source);
+        let base = self.original_start.unwrap_or(source);
+        let Some(next) = base.checked_add(1) else { return; };
+        self.to = Some(next);
+        if let Some(&token) = prompt.get(next) {
+            named.source = Some(next);
+            named.token = token;
+            self.applied = true;
+        }
+    }
+}
+#[cfg(test)]
+mod cursor_diagnostic_tests {
+    use super::*;
+    fn named(source: usize) -> Named { Named { token: 1, source: Some(source), by: Entry::Copy } }
+    #[test]
+    fn causal_read_controls() {
+        let prompt = [10, 11, 12, 13, 14];
+        let mut a = CursorIntervention::new(None);
+        let mut b = CursorIntervention::new(Some(0));
+        let mut an = named(2); let mut bn = an;
+        a.apply(&mut an, Some(2), &prompt, 3); b.apply(&mut bn, Some(2), &prompt, 3);
+        assert_eq!((an.source, an.token), (Some(3), 13));
+        assert_eq!((bn.source, bn.token), (Some(1), 11));
+        let mut same = CursorIntervention::new(Some(2)); let mut sn = named(2);
+        same.apply(&mut sn, Some(2), &prompt, 0); assert_eq!(sn, an);
+        let mut absent = CursorIntervention::new(None); let mut n = named(2);
+        absent.apply(&mut n, Some(1), &prompt, 0); assert!(!absent.triggered);
+        n.source = None; absent.apply(&mut n, Some(2), &prompt, 0); assert!(!absent.triggered);
+        let mut end = CursorIntervention::new(None); let mut en = named(4);
+        end.apply(&mut en, Some(4), &prompt, 0); assert!(end.triggered && !end.applied); assert_eq!(en.source, Some(4));
+        let mut invalid = CursorIntervention::new(Some(usize::MAX)); let mut inv = named(2);
+        invalid.apply(&mut inv, Some(2), &prompt, 0); assert!(invalid.triggered && !invalid.applied); assert_eq!(inv.source, Some(2));
+        let mut no_op = named(2); a.apply(&mut no_op, Some(2), &prompt, 4); assert_eq!(no_op.source, Some(2));
+    }
+}
 /// Stands for "none" in a step's words.
