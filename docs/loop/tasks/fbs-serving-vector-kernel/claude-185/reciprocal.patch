+/// claude-185: `stack_rotation` takes each coordinate's quotient from one reciprocal of the
+/// shared norm. It equals the four-divide form on every quaternion of edge values, and on a
+/// million seeded ones at every scale, for both epsilons and several `lambda`.
+#[test]
+fn rotation_by_one_reciprocal_equals_four_divides() {
+    use super::kernels::{mul_i128, stack_div_u128, stack_isqrt, stack_square};
+    use super::session::rotation_for_test;
+    fn by_divides(raw: [i32; 4], lambda: u64, epsilon: u128) -> [i64; 4] {
+        let mut square = 0u128;
+        for &v in &raw {
+            square = square.wrapping_add(u128::from(stack_square(i64::from(v))));
+        }
+        let norm = stack_isqrt((square + epsilon) << 32);
+        let mut out = [0i64; 4];
+        for (slot, &v) in out.iter_mut().zip(&raw) {
+            let magnitude = stack_div_u128(u128::from(v.unsigned_abs()) << 46, norm) as i128;
+            let unit = if v < 0 { -magnitude } else { magnitude };
+            *slot = (mul_i128(i128::from(lambda), unit) >> 30) as i64;
+        }
+        out
+    }
+    // The session's two epsilons (ROTATION_EPSILON, GATE_EPSILON) and its gate lambda, 2^31.
+    let epsilons = [4_295u128, 0];
+    let lambdas = [1u64 << 31, 1, (1u64 << 31) - 1, 1u64 << 40, 3_000_000_007];
+    let edges = [
+        0,
+        1,
+        -1,
+        2,
+        -2,
+        3,
+        46_341,
+        -46_341,
+        1 << 15,
+        -(1 << 15),
+        i32::MAX - 1,
+        i32::MIN + 1,
+        i32::MAX,
+        i32::MIN,
+    ];
+    let mut checked = 0u64;
+    for &a in &edges {
+        for &b in &edges {
+            for &c in &edges {
+                for &d in &edges {
+                    for &epsilon in &epsilons {
+                        for &lambda in &lambdas {
+                            let raw = [a, b, c, d];
+                            let got = rotation_for_test(raw, lambda, epsilon);
+                            assert_eq!(got, by_divides(raw, lambda, epsilon), "{raw:?} {lambda} {epsilon}");
+                            checked += 1;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    let mut rng = Lcg(185);
+    for _ in 0..1_000_000 {
+        // A random shift per quaternion covers every scale, down to norms near the floor.
+        let scale = (rng.next() % 32) as u32;
+        let mut raw = [0i32; 4];
+        for v in &mut raw {
+            *v = (rng.next() as i32) >> scale;
+        }
+        let epsilon = epsilons[(rng.next() % 2) as usize];
+        let lambda = lambdas[(rng.next() % lambdas.len() as u64) as usize];
+        let got = rotation_for_test(raw, lambda, epsilon);
+        assert_eq!(got, by_divides(raw, lambda, epsilon), "{raw:?} {lambda} {epsilon}");
+        checked += 1;
+    }
+    assert_eq!(checked, 14u64.pow(4) * 10 + 1_000_000);
+}
