+#[cfg(feature = "reader-serving")]
+fn run_discrete_question_script(
+    cli: &CliArgs,
+    model: &uor_r4_integer::discrete_d11::IntegerDiscreteModel,
+    path: &Path,
+) -> Result<()> {
+    let reader_sha = model
+        .question_reader_sha256()
+        .ok_or_else(|| IntegerError::Invalid("discrete scripts require a question reader".into()))?;
+    if cli.read_mode != ReadMode::Enabled || cli.memory.is_some() || cli.memory_sieve {
+        return Err(IntegerError::Invalid(
+            "question-reader scripts require the carried reader and use literal dialogue history".into(),
+        ));
+    }
+    let tokenizer_path = cli
+        .tokenizer_path
+        .as_deref()
+        .ok_or_else(|| IntegerError::Invalid("missing discrete tokenizer".into()))?;
+    let bytes = std::fs::read(tokenizer_path)?;
+    let digest = hex::encode(Sha256::digest(&bytes));
+    let tokenizer = discrete_text_tokenizer(model, &bytes, &digest)?;
+    let protocol = DialogueProtocol::literal_roles_version(&tokenizer, cli.protocol)
+        .map_err(|error| IntegerError::Invalid(error.to_string()))?;
+    let encoder = protocol
+        .bind(&tokenizer)
+        .map_err(|error| IntegerError::Invalid(error.to_string()))?;
+    let script = parse_chat_script(&std::fs::read(path)?, path).map_err(IntegerError::Invalid)?;
+    if script
+        .turns
+        .iter()
+        .any(|turn| turn.memory.is_some() || turn.memory_auto.is_some())
+    {
+        return Err(IntegerError::Invalid(
+            "question-reader scripts use literal dialogue history".into(),
+        ));
+    }
+    let mut history = vec![protocol.bos_id];
+    let mut transcript = Vec::with_capacity(script.turns.len());
+    let mut completed_turns = 0;
+    for turn in &script.turns {
+        let has_history = completed_turns > 0;
+        history.extend(encoder.encode_user_prefix(&turn.user, has_history).tokens);
+        if history.len() > model.shape().context as usize {
+            return Err(IntegerError::Invalid("discrete script exceeds model context".into()));
+        }
+        let reply = model.question_reply(&history, cli.max_tokens)?;
+        let visible = reply.strip_suffix(&[protocol.eos_id]);
+        let stop = reader_stop(visible.is_some(), reply.len(), cli.max_tokens);
+        transcript.push(serde_json::json!({
+            "user": turn.user,
+            "prompt_ids": history,
+            "reply_ids": reply,
+            "reply_text": tokenizer.decode(visible.unwrap_or(&reply)),
+            "stop": stop,
+        }));
+        if visible.is_none() {
+            break;
+        }
+        history.extend(reply);
+        completed_turns += 1;
+    }
+    println!(
+        "{}",
+        serde_json::to_string_pretty(&serde_json::json!({
+            "schema": "uor-r4.uor-chat-discrete-script/1",
+            "artifact_sha256": model.artifact_sha256(),
+            "question_reader_sha256": reader_sha,
+            "tokenizer_sha256": digest,
+            "protocol": protocol.schema,
+            "requested_turns": script.turns.len(),
+            "completed_turns": completed_turns,
+            "turns": transcript,
+        }))?
+    );
+    Ok(())
+}
+
+#[cfg(feature = "reader-serving")]
+fn reader_stop(eos: bool, emitted: usize, limit: usize) -> &'static str {
+    if eos {
+        "eos"
+    } else if emitted == limit {
+        "max_tokens"
+    } else {
+        "reader_exhausted"
+    }
+}
+
+fn discrete_text_tokenizer(
+    model: &uor_r4_integer::discrete_d11::IntegerDiscreteModel,
+    bytes: &[u8],
+    digest: &str,
+) -> Result<ByteBpeTokenizer> {
+    if model.tokenizer_sha256() != Some(digest) {
+        return Err(IntegerError::Invalid(
+            "discrete artifact does not bind this tokenizer SHA-256".into(),
+        ));
+    }
+    let tokenizer = ByteBpeTokenizer::from_tokenizer_json_bytes(bytes)
+        .ok_or_else(|| IntegerError::Invalid("invalid discrete tokenizer JSON".into()))?;
+    if tokenizer.vocab_size() != model.shape().vocabulary as usize {
+        return Err(IntegerError::Invalid(
+            "discrete tokenizer vocabulary mismatch".into(),
+        ));
+    }
+    Ok(tokenizer)
+}
