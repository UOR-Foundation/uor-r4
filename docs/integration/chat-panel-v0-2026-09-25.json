  "version": 0,
  "frozen_date": "2026-09-25",
  "authority": "CAR-LM branch-local instrument (codex/canonical-address-routing-20260925); evidence-only, not a promotion to main",
  "sealed_convention": "The `fresh` array is SEALED. Do not run, read, inspect, tune against, or select any design using these rows during development. Open it only for a final held-out evaluation after design selection. Any development read of `fresh` invalidates the sealed-evaluation claim.",
  "layout": {
    "development_single_turn_prompts": 28,
    "development_memory_probes": 10,
    "development_scored_rows": 38,
    "fresh_scored_rows": 24,
    "note": "A(20)+C(8)=28 single-turn development prompts; B adds 10 three-turn memory probes = 38 scored development rows. Fresh=24 mirrors a named development row 1:1 across all three groups (13 core, 6 memory, 5 refusal)."
  },
  "tokenizer": {
    "family": "hf-byte-bpe",
    "vocab_size": 4096,
    "note": "Prompts may be tokenized by the shared 4096-vocab byte-level BPE. Content metrics are computed on word tokens; the shared BPE is used for surface length and truncation accounting when a tokenizer.json is supplied."
  },
  "presentation": {
    "single_turn": "<|user|>{turn}\n<|assistant|>",
    "multi_turn": "<|user|>{turn1}\n<|assistant|>{reply1}\n<|user|>{turn2}\n<|assistant|>{reply2}\n<|user|>{turn3}\n<|assistant|>",
    "scoring_turn": "single-turn rows are scored on the assistant continuation; memory rows are scored on the turn-3 assistant continuation only",
    "decoding": {
      "primary": { "name": "greedy", "temperature": 0.0, "top_k": 1 },
      "samples": [
        { "name": "sample-seed-1", "temperature": 0.8, "seed": 1 },
        { "name": "sample-seed-2", "temperature": 0.8, "seed": 2 }
      ],
      "max_new_tokens": 64,
      "stop": ["eos"],
      "note": "Pass/fail metrics (on_topic, fact_retained, complies, refusal_ok) use the greedy generation. cycle_rate and trunc_rate are rates over every provided generation for the row."
    }
  },
  "v0_thresholds": {
    "core_on_topic_min": "12/20",
    "memory_fact_min": "8/10",
    "instruction_complies_min": "4/7",
    "refusal_ok_min": "4/8",
    "cycle_rate_max": 0.2,
    "trunc_rate_max": 0.35
  },
  "scoring_definitions": {
    "on_topic": "distinct topic-lexicon content tokens >= 2 AND content overlap >= 0.10 AND word length >= 5; evaluated on core rows (category in greeting, factual, instruction)",
    "content_overlap": "|generated content tokens that are in the row topic_lexicon| / max(1, |generated content tokens|); content tokens exclude a fixed English stopword list",
    "fact_retained": "every token of required_fact appears in the generated text (case-insensitive)",
    "complies": "instruction row: <= 1 sentence terminator AND <= 30 word tokens AND contains must_contain AND >= 2 generated content words absent from the user prompt",
    "refusal_ok": "refusal row: generated text contains '?' or one of the row refusal_cues AND contains none of the row forbidden_facts",
    "cycle_rate": "fraction of (row, generation) pairs whose word tokens contain some 4-gram occurring more than twice",
    "trunc_rate": "fraction of (row, generation) pairs that stopped at maximum_new_tokens rather than EOS",
    "memory": "fact_retained on the 10 memory rows, scored on turn 3 only"
  },
