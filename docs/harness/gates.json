{
  "version": 1,
  "gates": [
    {
      "id": "fmt-claim-wording",
      "proves": "The claim-wording crate is rustfmt-clean.",
      "command": [
        "cargo",
        "fmt",
        "-p",
        "uor-r4-claim-wording",
        "--check"
      ],
      "reads": [
        "crates/uor-r4-claim-wording/**/*.rs",
        "rustfmt.toml",
        ".rustfmt.toml"
      ],
      "quick": true,
      "break": {
        "file": "crates/uor-r4-claim-wording/src/lib.rs",
        "append": "\nfn  planted_break( ) { }\n",
        "expect": "+fn planted_break() {}"
      }
    },
    {
      "id": "fmt-harness",
      "proves": "The harness crate is rustfmt-clean.",
      "command": [
        "cargo",
        "fmt",
        "-p",
        "uor-r4-harness",
        "--check"
      ],
      "reads": [
        "crates/uor-r4-harness/**/*.rs",
        "rustfmt.toml",
        ".rustfmt.toml"
      ],
      "quick": true,
      "break": {
        "file": "crates/uor-r4-harness/src/labs.rs",
        "append": "\nfn  planted_break( ) { }\n",
        "expect": "+fn planted_break() {}"
      }
    },
    {
      "id": "claim-wording",
      "proves": "No document uses prohibited claim wording without a linked proof artifact.",
      "command": [
        "cargo",
        "run",
        "-q",
        "--locked",
        "-p",
        "uor-r4-claim-wording",
        "--",
        "."
      ],
      "reads": [
        "**/*.md",
        "crates/uor-r4-claim-wording/**"
      ],
      "quick": true,
      "break": {
        "file": "docs/README.md",
        "append": "\nThis result is machine-verified.\n",
        "expect": "This result is machine-verified."
      }
    },
    {
      "id": "loop-gates-watch",
      "proves": "The gate progress window shows gate N of M, the running gate, reds and the ledger estimate; it opens only for a full run in a terminal; and it gives up after five minutes without change.",
      "command": [
        "cargo",
        "test",
        "-q",
        "--locked",
        "-p",
        "uor-r4-harness",
        "--test",
        "loop_gates_watch"
      ],
      "reads": [
        "crates/uor-r4-harness/**/*.rs",
        "docs/harness/gates.json"
      ],
      "quick": false,
      "break": {
        "file": "crates/uor-r4-harness/tests/loop_gates_watch.rs",
        "append": "\n#[test]\nfn planted_break_watch() {\n    let mut calls = 0u64;\n    let mut out = Vec::new();\n    let mut read = || String::new();\n    let mut wait = || {\n        calls += 1;\n        if calls > 100 {\n            panic!(\"watch did not give up\");\n        }\n        std::thread::sleep(std::time::Duration::from_millis(2));\n    };\n    let _ = uor_r4_harness::loopgates::watch_loop(\n        &mut read,\n        &mut out,\n        &std::collections::BTreeMap::new(),\n        std::time::Duration::from_millis(1),\n        &mut wait,\n    );\n    assert!(String::from_utf8_lossy(&out).contains(\"giving up\"));\n}\n",
        "expect": "watch did not give up"
      }
    }
  ]
}
